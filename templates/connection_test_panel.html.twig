{% set status_labels = {
    'never': __('Not tested yet', 'domainmanager'),
    'success': __('Success'),
    'auth_failed': __('Authentication failed', 'domainmanager'),
    'forbidden': __('Forbidden', 'domainmanager'),
    'not_found': __('Not found', 'domainmanager'),
    'rate_limited': __('Rate limited', 'domainmanager'),
    'upstream_error': __('Upstream error', 'domainmanager'),
    'network_error': __('Network error', 'domainmanager'),
    'timeout': __('Timeout'),
    'unknown_error': __('Error'),
    'not_configured': __('Not configured', 'domainmanager'),
} %}
{% set status_classes = {
    'never': 'text-bg-secondary',
    'success': 'text-bg-success',
    'auth_failed': 'text-bg-danger',
    'forbidden': 'text-bg-danger',
    'not_found': 'text-bg-danger',
    'network_error': 'text-bg-danger',
    'unknown_error': 'text-bg-danger',
    'rate_limited': 'text-bg-warning',
    'upstream_error': 'text-bg-warning',
    'timeout': 'text-bg-warning',
    'not_configured': 'text-bg-warning',
} %}

{% import 'components/form/fields_macros.html.twig' as fields %}

{# Read-only diagnostics fragment — rendered inside the combined "Domain
 # Manager API access" card's body (supplier_tab.html.twig), not its own
 # card. Uses core's own field macros (fields_macros.html.twig), same as
 # every native itemtype form (e.g. Supplier's own showForm(), confirmed
 # via generic_show_form.html.twig on a live GLPI 11.0.8 instance) —
 # fields.smallTitle() for the icon divider, fields.readOnlyField()/
 # htmlField() for the values, which lay out two per row via the macros'
 # own col-12 col-sm-6 field wrapper. #}
{{ fields.smallTitle(__('Connection diagnostics', 'domainmanager'), 'ti ti-plug-connected') }}
<div id="domainmanager-test-panel" class="row">
    {% if not supplier_active|default(true) %}
        <div class="col-12">
            <div class="alert alert-secondary mb-0">
                <i class="ti ti-player-pause me-1"></i>
                {{ __('This supplier is inactive. Activate it to test or use its Domain Manager credentials.', 'domainmanager') }}
            </div>
        </div>
    {% else %}
        {% set entry = primary_capability is not null ? (connection_test[primary_capability]|default({'status': 'never', 'message': '', 'http_code': null, 'date': null})) : {'status': 'never', 'message': '', 'http_code': null, 'date': null} %}
        {% set status_value %}
            <span class="badge {{ status_classes[entry.status]|default('text-bg-secondary') }}"
                  id="domainmanager-test-badge">
                {{ status_labels[entry.status]|default(entry.status) }}
            </span>
            {% if entry.http_code %}
                <span class="text-muted small" id="domainmanager-test-httpcode">
                    HTTP {{ entry.http_code }}
                </span>
            {% else %}
                <span class="text-muted small d-none" id="domainmanager-test-httpcode"></span>
            {% endif %}
        {% endset %}
        {{ fields.htmlField('domainmanager_test_status', status_value, __('Connection status', 'domainmanager'), {
            'field_class': 'col-12 col-sm-6 domainmanager-test-capability',
            'add_field_attribs': primary_capability is not null ? {} : {'hidden': 'hidden'},
        }) }}
        {% set message_value %}
            <span id="domainmanager-test-message">{{ entry.message }}</span>
        {% endset %}
        {{ fields.htmlField('domainmanager_test_message', message_value, __('Message', 'domainmanager'), {
            'field_class': 'col-12 col-sm-6 domainmanager-test-capability',
            'add_field_attribs': primary_capability is not null ? {} : {'hidden': 'hidden'},
        }) }}
        {% set last_checked_value %}
            <span id="domainmanager-test-date" title="{{ entry.date }}">
                {{ entry.date ?: __('Never') }}
            </span>
        {% endset %}
        {{ fields.htmlField('domainmanager_test_date', last_checked_value, __('Last checked', 'domainmanager'), {
            'field_class': 'col-12 col-sm-6 domainmanager-test-capability',
            'add_field_attribs': primary_capability is not null ? {} : {'hidden': 'hidden'},
        }) }}
        <div class="col-12 text-muted small {{ primary_capability is not null ? 'd-none' : '' }}"
             id="domainmanager-test-none">
            {{ __('This driver has nothing to test.', 'domainmanager') }}
        </div>
    {% endif %}
</div>

<script>
    var domainmanagerStatusLabels  = {{ status_labels|json_encode|raw }};
    var domainmanagerStatusClasses = {{ status_classes|json_encode|raw }};
</script>
