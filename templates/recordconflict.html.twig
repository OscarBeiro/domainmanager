{#
 # Update-conflict resolution screen (ARCHITECTURE.md §13, Phase 44). Reached
 # from the flash message `DnsRecordWriteback::onPreUpdate()` shows on drift.
 #}
{% import 'components/form/basic_inputs_macros.html.twig' as inputs %}
<div class="card m-2">
    <div class="card-header">
        <div class="ribbon ribbon-bookmark ribbon-top ribbon-start bg-orange s-1">
            <i class="ti ti-world-cog fa-2x"></i>
        </div>
        <h4 class="card-title ps-5">{{ __('DNS record update conflict', 'domainmanager') }}</h4>
    </div>
    <div class="card-body">
        <p class="text-muted">
            {{ __('The record has changed at the provider since GLPI last synced it. Choose which value to keep.', 'domainmanager') }}
        </p>
        <p>
            <strong>{{ type_name }}</strong> — {{ record.fields.name ?: '@' }}
        </p>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="card border-primary h-100">
                    <div class="card-header">{{ __('Your GLPI edit', 'domainmanager') }}</div>
                    <div class="card-body">
                        <div><strong>{{ __('Value') }}:</strong> {{ conflict.fields.submitted_data }}</div>
                        <div><strong>TTL:</strong> {{ conflict.fields.submitted_ttl }}</div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-secondary h-100">
                    <div class="card-header">{{ __('Current value at %s', 'domainmanager')|format(driver_name) }}</div>
                    <div class="card-body">
                        <div><strong>{{ __('Value') }}:</strong> {{ conflict.fields.live_data }}</div>
                        <div><strong>TTL:</strong> {{ conflict.fields.live_ttl }}</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2 mt-3">
            <form method="post" action="{{ keep_glpi_url }}" data-submit-once>
                {{ inputs.hidden('_glpi_csrf_token', csrf_token()) }}
                <button type="submit" class="btn btn-primary">
                    <i class="ti ti-device-floppy"></i>
                    {{ __('Keep my GLPI value', 'domainmanager') }}
                </button>
            </form>
            <form method="post" action="{{ keep_provider_url }}" data-submit-once>
                {{ inputs.hidden('_glpi_csrf_token', csrf_token()) }}
                <button type="submit" class="btn btn-secondary">
                    <i class="ti ti-cloud-download"></i>
                    {{ __('Keep the provider\'s value', 'domainmanager') }}
                </button>
            </form>
            <form method="post" action="{{ cancel_url }}" data-submit-once>
                {{ inputs.hidden('_glpi_csrf_token', csrf_token()) }}
                <button type="submit" class="btn btn-outline-secondary">
                    {{ __('Cancel') }}
                </button>
            </form>
            <a href="{{ record_url }}" class="btn btn-link ms-auto">{{ __('Back to record') }}</a>
        </div>
    </div>
</div>
