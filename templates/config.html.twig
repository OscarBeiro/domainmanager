{#
#}

{% import 'components/form/fields_macros.html.twig' as fields %}

<div class="col-12 col-xxl-8 mb-4">
    {# TemplateRenderer's path() has no Symfony router, so route names don't
       resolve here — it only prefixes a literal URL path with root_doc. #}
    <form method="post" action="{{ path('/plugins/domainmanager/Config/Save') }}" data-submit-once>
        {{ fields.csrfField() }}

        {{ fields.dropdownField(
            'DomainType',
            'domaintypes_id',
            domaintypes_id,
            __('Default domain type', 'domainmanager'),
            {
                'full_width': true,
                'display_emptychoice': true,
                'helper': __('Applied once, only when the plugin creates a new domain (bulk import). Left empty, imported domains get no type, same as one created by hand. Never changes an existing domain\'s type on a later sync.', 'domainmanager'),
            }
        ) }}

        {# §15.3 Phase 53: global write kill switch — hard-disables every
           outbound DNS record mutation across every driver, independent of
           per-type write-back rights. Deactivating a supplier is not a
           substitute, since that also kills reads/sync. #}
        {{ fields.sliderField(
            'read_only_mode',
            read_only_mode ? 1 : 0,
            __('Read-only mode', 'domainmanager'),
            {
                'full_width': true,
                'disabled': not can_edit,
                'helper': __('When enabled, Domain Manager refuses to push any DNS record change (create/update/delete/restore) to any provider. Reads and sync are unaffected.', 'domainmanager'),
            }
        ) }}

        <hr>

        {# §15.3 Phase 55: sync safety guard on reconciliation — a sync run
           that would trash more than either threshold refuses to apply and
           leaves the domain's records untouched instead. #}
        <div class="alert alert-warning" role="alert">
            <i class="ti ti-alert-triangle me-1"></i>
            {{ __('Advanced: sync safety guard thresholds. Leave at the defaults unless you understand exactly what they control — lowering them can cause normal syncs to be refused, while raising them weakens protection against a mis-scoped credential trashing DNS records.', 'domainmanager') }}
        </div>

        {{ fields.numberField(
            'sync_safety_max_count',
            sync_safety_max_count,
            __('Max records trashed per sync', 'domainmanager'),
            {
                'full_width': true,
                'disabled': not can_edit,
                'min': 0,
                'helper': __('A single synchronization is refused, and the domain left untouched, once it would move more than this many records to the trash bin, or more than the percentage below of the domain\'s currently-owned records — whichever is hit first.', 'domainmanager'),
            }
        ) }}

        {{ fields.numberField(
            'sync_safety_max_percent',
            sync_safety_max_percent,
            __('Max percent of records trashed per sync', 'domainmanager'),
            {
                'full_width': true,
                'disabled': not can_edit,
                'min': 0,
                'max': 100,
            }
        ) }}

        {% if can_edit %}
            <div class="d-flex justify-content-end">
                <button type="submit" name="update" class="btn btn-primary">
                    <i class="ti ti-device-floppy me-1"></i>{{ __('Save') }}
                </button>
            </div>
        {% endif %}
    </form>

    {# §9 Phase 23: read-only status line for the RDAP enrichment cron
       (Setup > Automatic actions has the frequency/parameter; this just
       gives an at-a-glance sense of whether it's running/keeping up). #}
    <div class="text-muted small mt-3">
        <i class="ti ti-satellite me-1"></i>
        {% if rdap_enrichment.last_processed %}
            {{ __('%d domain(s) pending RDAP enrichment, last processed at %s', 'domainmanager')|format(rdap_enrichment.pending, rdap_enrichment.last_processed) }}
        {% else %}
            {{ __('%d domain(s) pending RDAP enrichment, none processed yet', 'domainmanager')|format(rdap_enrichment.pending) }}
        {% endif %}
    </div>
</div>
