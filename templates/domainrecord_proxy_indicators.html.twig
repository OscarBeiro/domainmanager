{#
 # Rendered from `DomainForm::renderProxyIndicators()` on the Records tab.
 # `DomainRecord::showForDomain()` is core's own hardcoded datatable with no
 # extension point for an extra column, so every indicator here is overlaid
 # client-side next to (or under) the cell that already holds the matching
 # record id — found via the record id already present in the Name link's
 # native `getFormURLWithID()` href, then walked positionally to sibling
 # cells (core's own fixed Type/Name/TTL/Target column order, confirmed
 # against `DomainRecord::showForDomain()` on `11.0/bugfixes`).
 #
 # Three independent, data-presence-gated overlays:
 # - A cloud icon next to the Name link for any proxied record.
 # - The persisted anycast address(es), as a second line under the Target
 #   cell's origin IP (§9 research "persist proxy addresses + TTL-auto
 #   flag") — one column across from the icon, same treatment the Name cell
 #   used to get before the live-lookup "Show public IP" button (removed:
 #   the value is now persisted, so there is nothing left to fetch on click,
 #   and per that research's own point 9, it must not display in two
 #   places). Prefixed with its own cloud icon (same icon/tooltip as the
 #   Name cell's) so the line reads as "this is the proxy address" on sight,
 #   rather than a second, unexplained IP next to the origin one.
 # - "Automatic" (translated) replacing a `1`-second TTL in the TTL cell,
 #   raw value kept as a hover tooltip.
 #}
<script>
    (function () {
        var proxiedIds   = {{ proxied_ids|json_encode|raw }};
        var proxyAddrs   = {{ proxy_addresses|json_encode|raw }};
        var ttlAutoIds   = {{ ttl_auto_ids|json_encode|raw }};
        var cloudTitle   = {{ __('Proxied through Cloudflare', 'domainmanager')|json_encode|raw }};
        var autoLabel    = {{ __('Automatic', 'domainmanager')|json_encode|raw }};

        document.querySelectorAll('a[href*="domainrecord.form.php?id="]').forEach(function (link) {
            var match = link.href.match(/[?&]id=(\d+)/);
            if (!match) {
                return;
            }
            var recordId = parseInt(match[1], 10);
            var nameTd   = link.closest('td');
            if (!nameTd) {
                return;
            }
            var ttlTd  = nameTd.nextElementSibling;
            var dataTd = ttlTd ? ttlTd.nextElementSibling : null;

            if (proxiedIds.indexOf(recordId) !== -1 && !(link.nextSibling && link.nextSibling.classList && link.nextSibling.classList.contains('domainmanager-proxy-indicator'))) {
                var icon = document.createElement('i');
                icon.className = 'ti ti-cloud-filled text-primary ms-1 domainmanager-proxy-indicator';
                icon.title = cloudTitle;
                link.parentNode.insertBefore(icon, link.nextSibling);
            }

            var addresses = proxyAddrs[recordId];
            if (addresses && addresses.length && dataTd && !dataTd.querySelector('.domainmanager-proxy-addresses')) {
                var addrLine = document.createElement('div');
                addrLine.className = 'text-muted small domainmanager-proxy-addresses';

                var addrIcon = document.createElement('i');
                addrIcon.className = 'ti ti-cloud-filled text-primary me-1';
                addrIcon.title = cloudTitle;
                addrLine.appendChild(addrIcon);
                addrLine.appendChild(document.createTextNode(addresses.join(', ')));

                dataTd.appendChild(addrLine);
            }

            if (ttlAutoIds.indexOf(recordId) !== -1 && ttlTd && !ttlTd.classList.contains('domainmanager-ttl-auto')) {
                ttlTd.classList.add('domainmanager-ttl-auto');
                ttlTd.title = ttlTd.textContent.trim();
                ttlTd.textContent = autoLabel;
            }
        });
    })();
</script>
