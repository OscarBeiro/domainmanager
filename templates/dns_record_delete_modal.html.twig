{# Delete modal for DNS records (ARCHITECTURE.md §11.10) — shows the record
   and states plainly that it cannot be undone. #}

<form method="post" action="{{ path('@domainmanager:domainmanager_dnsrecord_delete', { 'domains_id': domain.fields.id, 'domainrecords_id': record.fields.id }) }}" id="domainmanager-dnsrecord-delete-form">
    <div class="modal-body">
        <div class="alert alert-danger">
            <i class="ti ti-alert-circle me-1"></i>
            {{ __('This action cannot be undone. The record will be deleted from both GLPI and the DNS provider.', 'domainmanager') }}
        </div>

        <div class="mb-3">
            <label class="form-label">{{ __('Domain', 'domainmanager') }}</label>
            <div class="form-control-plaintext">{{ domain.fields.name }}</div>
        </div>

        <div class="mb-3">
            <label class="form-label">{{ __('Record', 'domainmanager') }}</label>
            <div class="form-control-plaintext">
                {{ record.fields.name }}
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">{{ __('Data', 'domainmanager') }}</label>
            <div class="form-control-plaintext" style="word-break: break-all;">{{ record.fields.data }}</div>
        </div>
    </div>
    <div class="modal-footer">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ _x('button', 'Cancel') }}</button>
        <button type="submit" class="btn btn-danger">
            <i class="ti ti-trash"></i>
            {{ __('Delete record', 'domainmanager') }}
        </button>
    </div>
</form>
