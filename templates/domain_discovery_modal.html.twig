{# Loaded into .modal-body by core's own Ajax::createModalWindow() (see
   SupplierTab::showForSupplier()) — components/modal.html.twig already
   provides the .modal-header (title + close button) and the surrounding
   .modal-dialog/.modal-content chrome, so this fragment only ever renders
   what belongs inside .modal-body. #}

{% if not can_create %}
    <div class="modal-body">
        <div class="alert alert-danger mb-0">
            <i class="ti ti-alert-triangle me-1"></i>
            {{ __('You do not have permission to create domains, so none of the domains discovered below can be imported.', 'domainmanager') }}
        </div>
    </div>
{% elseif rows is empty %}
    <div class="modal-body">
        <div class="text-muted small">
            {{ __('No pending domains to import: this supplier\'s account has no domains.', 'domainmanager') }}
        </div>
    </div>
{% elseif rows|filter(row => not row.exists) is empty %}
    <div class="modal-body">
        <div class="text-muted small">
            {{ __('No pending domains to import: every domain found in this supplier\'s account already exists in GLPI.', 'domainmanager') }}
        </div>
    </div>
{% else %}
    <form method="post" action="{{ import_url }}" id="domainmanager-import-form">
        <div class="modal-body">
            <div class="mb-3 row">
                <label class="col-3 col-form-label">{{ __('Import into entity', 'domainmanager') }}</label>
                <div class="col-9">
                    {{ entity_dropdown|raw }}
                </div>
            </div>
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th style="width:2rem">
                            <input type="checkbox" class="form-check-input" id="domainmanager-import-select-all" checked>
                        </th>
                        <th>{{ __('Domain', 'domainmanager') }}</th>
                        <th>{{ __('Status', 'domainmanager') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            <td>
                                <input type="checkbox" class="form-check-input domainmanager-import-checkbox"
                                       name="_import[]" value="{{ row.name }}"
                                       {{ row.exists ? 'disabled' : 'checked' }}>
                            </td>
                            <td>
                                {% if row.exists %}
                                    <a href="{{ row.url }}">{{ row.name }}</a>
                                {% else %}
                                    {{ row.name }}
                                {% endif %}
                            </td>
                            <td>
                                {% if not row.exists %}
                                    <span class="text-muted">{{ __('Not yet in GLPI', 'domainmanager') }}</span>
                                    {% if row.preview_status %}
                                        <span class="text-muted small">({{ row.preview_status }})</span>
                                    {% endif %}
                                {% elseif row.mismatch %}
                                    <span class="badge text-bg-warning">{{ __('Registrar mismatch', 'domainmanager') }}</span>
                                    <button type="button" class="btn btn-sm btn-outline-warning ms-1 domainmanager-reassign-btn"
                                            data-domains-id="{{ row.domains_id }}"
                                            data-suppliers-id="{{ suppliers_id }}">
                                        {% if row.existing_suppliers_id > 0 %}
                                            {{ __('Reassign registrar to %s', 'domainmanager')|format(supplier_name) }}
                                        {% else %}
                                            {{ __('Set registrar to %s', 'domainmanager')|format(supplier_name) }}
                                        {% endif %}
                                    </button>
                                {% else %}
                                    <span class="text-muted">{{ __('Already exists', 'domainmanager') }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="modal-footer">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ _x('button', 'Cancel') }}</button>
            <button type="submit" class="btn btn-primary">
                <i class="ti ti-download"></i>
                {{ __('Import selected domains', 'domainmanager') }}
            </button>
        </div>
    </form>
{% endif %}

<script>
    (function () {
        const selectAll = document.getElementById('domainmanager-import-select-all');
        if (selectAll) {
            selectAll.addEventListener('change', function () {
                document.querySelectorAll('.domainmanager-import-checkbox:not(:disabled)').forEach(function (cb) {
                    cb.checked = selectAll.checked;
                });
            });
        }

        document.querySelectorAll('.domainmanager-reassign-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                btn.disabled = true;

                const body = new URLSearchParams();
                body.append('suppliers_id', btn.dataset.suppliersId);

                const csrf = document.querySelector('meta[property="glpi:csrf_token"]');
                fetch({{ reassign_url|json_encode|raw }} + btn.dataset.domainsId, {
                    method: 'POST',
                    headers: {
                        'X-Glpi-Csrf-Token': csrf ? csrf.getAttribute('content') : '',
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: body.toString()
                }).then(function (response) {
                    return response.text().then(function (text) {
                        var data = null;
                        try {
                            data = text ? JSON.parse(text) : null;
                        } catch (e) {
                            data = null;
                        }
                        return { ok: response.ok, data: data };
                    });
                }).then(function (result) {
                    if (result.data === null || !result.ok || result.data.ok !== true) {
                        throw new Error((result.data && (result.data.message)) || 'unknown error');
                    }

                    const row = btn.closest('tr');
                    btn.parentElement.innerHTML = '<span class="text-success"><i class="ti ti-check"></i> '
                        + {{ __('Reassigned', 'domainmanager')|json_encode|raw }} + '</span>';
                    const checkbox = row.querySelector('.domainmanager-import-checkbox');
                    if (checkbox) {
                        checkbox.checked = false;
                        checkbox.disabled = true;
                    }

                    glpi_toast_success(result.data.supplier_name, {{ __('Registrar reassigned', 'domainmanager')|json_encode|raw }});
                }).catch(function (error) {
                    glpi_toast_error(error.message);
                    btn.disabled = false;
                });
            });
        });
    })();
</script>
