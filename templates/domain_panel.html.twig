{% set detected = state ? state.detected_provider : '' %}
{% set rstatus = state ? state.registrar_status : 'never' %}
{% set dstatus = state ? state.dns_status : 'never' %}
{# Deep-link to a Supplier's own Domain Manager tab (verified against the
   real tab identifier GLPI renders for this class, §6.2); falls back
   gracefully to the Supplier's main record if this convention ever changes. #}
{% set supplier_tab_forcetab = '&forcetab=GlpiPlugin%5CDomainmanager%5CSupplierTab%241' %}

<div id="domainmanager-panel" class="card m-2 border-0 shadow-none">
    <div class="card-header">
        <div class="ribbon ribbon-bookmark ribbon-top ribbon-start bg-blue s-1">
            <i class="ti ti-world-cog fa-2x"></i>
        </div>
        <h4 class="card-title ps-5">
            {{ __('Domain Manager', 'domainmanager') }}
        </h4>
    </div>

    {% if not is_new %}
        <div class="card-body p-0">
            {% set visit_target = punycode ?: domain_name %}
            <div class="p-2 d-flex align-items-baseline gap-2 flex-wrap">
                <a href="https://{{ visit_target }}" target="_blank" rel="noopener noreferrer"
                   class="fs-4 fw-medium" title="{{ __('Visit this domain', 'domainmanager') }}">
                    {{ domain_name }}
                    <i class="ti ti-external-link fs-6"></i>
                </a>
                {% if punycode %}
                    <div class="text-muted small">
                        <code>{{ punycode }}</code>
                        <button type="button" class="btn btn-sm btn-link p-0 ms-1"
                                data-glpi-clipboard-text="{{ punycode }}"
                                title="{{ __('Copy Punycode form', 'domainmanager') }}">
                            <i class="ti ti-copy"></i>
                        </button>
                    </div>
                {% endif %}
            </div>
            {% if not is_managed %}
                {# §9 Phase 49 addendum, per user request: a domain with no
                   API-backed registrar/DNS supplier configured at all has
                   nothing genuine to show in the table/badges/messaging
                   below — every column would just read "Not configured" /
                   "Never synchronized", which reads as broken rather than
                   simply "nothing set up yet". Collapsed to a single
                   actionable line instead; the moment either supplier
                   resolves to an active driver (`is_managed` flips true),
                   this domain gets the full detail view below like any
                   other managed domain. #}
                <div class="p-3 text-muted small">
                    {{ __('Not managed by Domain Manager: no registrar or DNS supplier with API access is configured for this domain.', 'domainmanager') }}
                    {% if not registrar_supplier %}
                        <a href="{{ infocom_tab_url }}">{{ __('Set the Registrar via the Financial and administrative information tab', 'domainmanager') }}</a>
                    {% endif %}
                </div>
            {% else %}
            <div class="p-3">
                <div class="hr-text">
                    <i class="ti ti-server"></i>
                    <span>{{ __('Providers & key dates', 'domainmanager') }}</span>
                </div>
                <div class="row">
                    <div class="mb-3 col-12 col-sm-3">
                        <label class="form-label">{{ __('Registrar', 'domainmanager') }}</label>
                        <div>
                            {% if registrar_supplier %}
                                <a href="{{ registrar_supplier.getLinkURL() ~ supplier_tab_forcetab }}">{{ registrar_supplier.getName() }}</a>
                            {% else %}
                                <span class="text-muted">{{ __('No registrar supplier set', 'domainmanager') }}</span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="mb-3 col-12 col-sm-3">
                        <label class="form-label">{{ __('DNS Provider', 'domainmanager') }}</label>
                        <div id="domainmanager-provider">
                            {% if detected == '' %}
                                <span class="text-muted">{{ __('Never synchronized', 'domainmanager') }}</span>
                            {% elseif dns_supplier %}
                                <a href="{{ dns_supplier.getLinkURL() ~ supplier_tab_forcetab }}">{{ detected }}</a>
                            {% else %}
                                {{ detected }}
                            {% endif %}
                        </div>
                    </div>
                    <div class="mb-3 col-12 col-sm-3">
                        <label class="form-label">{{ __('Registrar sync', 'domainmanager') }}</label>
                        <div>
                            <span class="badge {{ status_classes[rstatus]|default('text-bg-secondary') }}"
                                  id="domainmanager-badge-registrar"
                                  data-bs-toggle="tooltip"
                                  title="{{ state ? state.registrar_message : '' }}">
                                {{ status_labels[rstatus]|default(rstatus) }}
                            </span>
                        </div>
                    </div>
                    <div class="mb-3 col-12 col-sm-3">
                        <label class="form-label">{{ __('DNS sync', 'domainmanager') }}</label>
                        <div>
                            <span class="badge {{ status_classes[dstatus]|default('text-bg-secondary') }}"
                                  id="domainmanager-badge-dns"
                                  data-bs-toggle="tooltip"
                                  title="{{ state ? state.dns_message : '' }}">
                                {{ status_labels[dstatus]|default(dstatus) }}
                            </span>
                        </div>
                    </div>
                    <div class="mb-3 col-12 col-sm-3">
                        <label class="form-label">{{ __('Last changed', 'domainmanager') }}</label>
                        <div>
                            {% if state and state.last_changed_date %}
                                {{ state.last_changed_date }}
                            {% else %}
                                <span class="text-muted" title="{{ __('Not yet checked', 'domainmanager') }}">&mdash;</span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="mb-3 col-12 col-sm-3">
                        <label class="form-label">{{ __('Last transfer', 'domainmanager') }}</label>
                        <div>
                            {% if state and state.transfer_date %}
                                {{ state.transfer_date }}
                            {% else %}
                                <span class="text-muted" title="{{ __('Not yet checked, or never transferred', 'domainmanager') }}">&mdash;</span>
                            {% endif %}
                        </div>
                    </div>
                    {# §9 Phase 25: RDAP-sourced, independent of driver sync outcome —
                       shown whenever RDAP has reported a value, regardless of rstatus/dstatus.
                       No "(RDAP)" in the visible label — the source doesn't matter to the
                       viewer, only the data does (per explicit request); kept in the tooltip
                       and in ARCHITECTURE.md/CHANGELOG.md instead. #}
                    <div class="mb-3 col-12 col-sm-3">
                        <label class="form-label">{{ __('Reg/DNS last sync', 'domainmanager') }}</label>
                        <div id="domainmanager-lastsync">
                            {{ state and state.last_sync_date ? state.last_sync_date : __('Never', 'domainmanager') }}
                            {% if can_update and is_managed %}
                                <i class="ti ti-refresh ms-1" id="domainmanager-sync-regdns" role="button"
                                   data-bs-toggle="tooltip" title="{{ __('Sync registrar/DNS now', 'domainmanager') }}"></i>
                            {% endif %}
                        </div>
                    </div>
                    <div class="mb-3 col-12 col-sm-3">
                        <label class="form-label">{{ __('RDAP last sync', 'domainmanager') }}</label>
                        <div id="domainmanager-lastrdap">
                            {% if state and state.last_rdap_check_date %}
                                {{ state.last_rdap_check_date }}
                            {% else %}
                                <span class="text-muted" title="{{ __('Not yet checked', 'domainmanager') }}">&mdash;</span>
                            {% endif %}
                            {% if can_update and is_managed %}
                                <i class="ti ti-refresh ms-1" id="domainmanager-sync-rdap" role="button"
                                   data-bs-toggle="tooltip" title="{{ __('Run RDAP lookup now', 'domainmanager') }}"></i>
                            {% endif %}
                        </div>
                    </div>
                </div>

                {% if not registrar_supplier %}
                    <div class="text-muted small lh-sm mb-1">
                        <a href="{{ infocom_tab_url }}">{{ __('Set the Registrar via the Financial and administrative information tab', 'domainmanager') }}</a>
                    </div>
                {% endif %}

                <div class="alert alert-warning mt-2 mb-0 {{ dstatus in ['unsupported', 'unknown'] ? '' : 'd-none' }}"
                     id="domainmanager-provider-warning" role="alert">
                    <i class="ti ti-alert-triangle me-1"></i>
                    <span id="domainmanager-provider-warning-text">
                        {% if dstatus == 'unsupported' %}
                            {{ __('API integration for %s is not currently supported.', 'domainmanager')|format(detected) }}
                        {% elseif dstatus == 'unknown' %}
                            {{ __('The DNS provider of this domain could not be identified.', 'domainmanager') }}
                        {% endif %}
                    </span>
                    <a href="{{ repository_url }}" target="_blank" rel="noopener noreferrer">
                        {{ __('Help us support this provider', 'domainmanager') }}
                    </a>
                </div>
            </div>

            {# §9 Phase 7: registrar administrative metadata. Only shown once
               the most recent registrar sync actually succeeded — a field
               left null here can mean either "this driver doesn't report
               it" (§6.2 boolean/text fallback below) or "never synced",
               and gating the whole block on rstatus == 'ok' avoids
               presenting a bare wall of "—" for a domain that was never
               synced at all. No RDAP-vs-driver distinction shown here — RDAP
               fills the same fields the driver itself writes to (§9 Phase
               27), so a single plain Yes/No/— reading is always accurate. #}
            {% if rstatus == 'ok' %}
                <div class="p-3 pt-0">
                    <div class="hr-text">
                        <i class="ti ti-shield-lock"></i>
                        <span>{{ __('Registrar security flags', 'domainmanager') }}</span>
                    </div>
                    <div class="row">
                        <div class="mb-3 col-12 col-sm-3">
                            <label class="form-label">{{ __('WHOIS privacy', 'domainmanager') }}</label>
                            <div>
                                {% if state.registrar_privacy_enabled is null %}
                                    <span class="text-muted" title="{{ __('Not reported by this driver', 'domainmanager') }}">&mdash;</span>
                                {% elseif state.registrar_privacy_enabled %}
                                    <span class="badge text-bg-success">{{ __('Yes', 'domainmanager') }}</span>
                                {% else %}
                                    <span class="badge text-bg-secondary">{{ __('No', 'domainmanager') }}</span>
                                {% endif %}
                            </div>
                        </div>
                        {% for field, label in {
                            'registrar_transfer_lock': __('Transfer lock', 'domainmanager'),
                            'registrar_domain_lock': __('Domain lock', 'domainmanager'),
                            'registrar_auto_renew': __('Auto-renew', 'domainmanager'),
                            'registrar_dnssec_enabled': __('DNSSEC', 'domainmanager'),
                        } %}
                            <div class="mb-3 col-12 col-sm-3">
                                <label class="form-label">{{ label }}</label>
                                <div>
                                    {% if state[field] is null %}
                                        <span class="text-muted" title="{{ __('Not reported', 'domainmanager') }}">&mdash;</span>
                                    {% elseif state[field] %}
                                        <span class="badge text-bg-success">{{ __('Yes', 'domainmanager') }}</span>
                                    {% else %}
                                        <span class="badge text-bg-secondary">{{ __('No', 'domainmanager') }}</span>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                        {# §9 Phase 23/27: no driver ever reports these, so they're
                           always RDAP-only, but no longer named with an "rdap_"
                           prefix (source doesn't belong in the field name). #}
                        {% for field, label in {
                            'pending_delete': __('Pending delete', 'domainmanager'),
                            'pending_transfer': __('Pending transfer', 'domainmanager'),
                        } %}
                            <div class="mb-3 col-12 col-sm-3">
                                <label class="form-label">{{ label }}</label>
                                <div>
                                    {% if state[field] is null %}
                                        <span class="text-muted" title="{{ __('Not yet checked', 'domainmanager') }}">&mdash;</span>
                                    {% elseif state[field] %}
                                        <span class="badge text-bg-danger">{{ __('Yes', 'domainmanager') }}</span>
                                    {% else %}
                                        <span class="badge text-bg-secondary">{{ __('No', 'domainmanager') }}</span>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {# §9 Phase 23/28: registrar-of-record / nameserver cross-check —
               diagnostic only (never wired into any lock/sync/reassignment
               path, §9 Phase 21/22 note), shown only when RDAP's view
               actually disagrees with what's currently on record, to avoid
               noise on the (expected) common case where they agree.
               `registrar_mismatch`/`ns_mismatch` are computed in
               DomainForm::inject() (normalized comparisons — legal-suffix-
               tolerant name matching, order/case-insensitive nameserver
               sets), not here — a naive exact-match here previously flagged
               harmless differences (RDAP's legal-form registrar name,
               reordered nameserver lists) as false-positive mismatches. #}
            {% if registrar_mismatch or ns_mismatch %}
                <div class="p-3 pt-0">
                    <div class="hr-text">
                        <i class="ti ti-info-circle"></i>
                        <span>{{ __('RDAP cross-check', 'domainmanager') }}</span>
                    </div>
                    {% if registrar_mismatch %}
                        <div class="small mb-1">
                            <span class="badge text-bg-warning me-1">{{ __('Registrar mismatch', 'domainmanager') }}</span>
                            {{ __('RDAP reports', 'domainmanager') }}
                            <strong>{{ state.rdap_registrar_name }}{{ state.rdap_registrar_iana_id ? ' (IANA #' ~ state.rdap_registrar_iana_id ~ ')' : '' }}</strong>
                            &middot;
                            {{ __('Supplier on file', 'domainmanager') }}: <strong>{{ registrar_supplier.getName() }}</strong>
                        </div>
                    {% endif %}
                    {% if ns_mismatch %}
                        <div class="small">
                            <span class="badge text-bg-warning me-1">{{ __('Nameserver mismatch', 'domainmanager') }}</span>
                            {{ __('RDAP', 'domainmanager') }}: <strong>{{ rdap_nameservers|join(', ') }}</strong>
                            &middot;
                            {{ __('Live', 'domainmanager') }}: <strong>{{ live_nameservers|join(', ') }}</strong>
                        </div>
                    {% endif %}
                </div>
            {% endif %}
            {% endif %}

            {# §9 Phase 94: relocated into the Domain form's own native
               Save/Put in trashbin button row (`.form-button-separator` in
               `components/form/buttons.html.twig`) by the script below,
               same DOM-relocation technique this plugin already used for
               the earlier "Update Now" button (§9 Phase 9 addendum) — a
               plugin has no way to render directly into that row (it's
               generated by core's own `showFormButtons()` for `Domain`,
               not reachable from a plugin hook). Rendered `d-none` here so
               there's no flash of it in the wrong place before the script
               runs. Styled `btn-outline-secondary`, the same class core's
               own `addbuttons` mechanism defaults to for a plugin-contributed
               button in this exact row. #}
            <a href="https://who.is/whois/{{ visit_target }}" target="_blank" rel="noopener noreferrer"
               id="domainmanager-whois" class="btn btn-outline-secondary me-2 d-none">
                <i class="ti ti-search"></i>
                <span>{{ __('WHOIS', 'domainmanager') }}</span>
            </a>
            {% if registrar_supplier and can_update %}
                <button type="button" class="btn btn-outline-secondary me-2 d-none" id="domainmanager-unlink-registrar">
                    <i class="ti ti-unlink"></i>
                    <span>{{ __('Unlink registrar', 'domainmanager') }}</span>
                </button>
            {% endif %}
        </div>
    {% else %}
        <div class="card-body">
            <div class="text-muted small">
                {{ __('Registrar and DNS provider information is available after the domain is created.', 'domainmanager') }}
            </div>
        </div>
    {% endif %}
</div>

<script>
(function () {

    // §9 Phase 94: relocate the WHOIS/Unlink registrar buttons into the
    // Domain form's own native Save/Put in trashbin row, same technique
    // already used for the earlier "Update Now" button (§9 Phase 9
    // addendum). Runs immediately, not on DOMContentLoaded — this whole
    // panel (this `<script>` included) is itself injected into the page
    // later via AJAX (the Domain form's tab-loading mechanism), by which
    // point `DOMContentLoaded` has long since fired for the outer page and
    // would never fire again; the native button row is already present in
    // the DOM by the time this script runs, so no deferral is needed.
    // Inserted right after the native Save button when present (its own
    // flex-row-reverse layout then places these visually just left of
    // Save), else appended.
    (function relocateButtons() {
        const buttonRow = document.querySelector('.form-button-separator');
        if (!buttonRow) {
            return;
        }
        let anchor = buttonRow.querySelector('button[name="update"]');
        ['domainmanager-whois', 'domainmanager-unlink-registrar'].forEach(function (id) {
            const button = document.getElementById(id);
            if (!button) {
                return;
            }
            if (anchor) {
                anchor.insertAdjacentElement('afterend', button);
            } else {
                buttonRow.appendChild(button);
            }
            button.classList.remove('d-none');
            anchor = button;
        });
    })();

    // Cosmetic lock layer: disable synced fields for users without the
    // unlock right (server-side enforcement is authoritative)
    const lockedFields = {{ locked_fields|json_encode|raw }};
    if (lockedFields.length) {
        const form = document.querySelector('#domainmanager-panel').closest('form');
        if (form) {
            lockedFields.forEach(function (field) {
                form.querySelectorAll('[name="' + field + '"]').forEach(function (input) {
                    input.disabled = true;

                    // A Dropdown::show() field (e.g. domaintypes_id) is a
                    // <select> re-rendered by select2 into its own sibling
                    // widget — disabling the original (hidden) <select>
                    // locks it functionally, but select2's visible box is
                    // left looking fully enabled since it never re-reads the
                    // underlying element's state on its own. Greying it out
                    // needs jQuery's `disabled` triggering select2's own
                    // update path (plain `input.disabled = true` above alone
                    // isn't picked up by it), falling back to a manual style
                    // tweak if jQuery/select2 aren't present for some reason.
                    if (typeof window.jQuery === 'function' && window.jQuery(input).data('select2')) {
                        window.jQuery(input).prop('disabled', true).trigger('change.select2');
                    } else {
                        const container = input.nextElementSibling;
                        if (container && container.classList.contains('select2')) {
                            container.style.opacity = '0.65';
                            container.style.pointerEvents = 'none';
                        }
                    }

                    // A date/datetime field (e.g. date_domaincreation,
                    // date_expiration) is built by fields_macros.html.twig's
                    // dateField()/datetimeField(), which generates the
                    // flatpickr wrapper's own random id independently of the
                    // outer field() macro's label `for` — the two never
                    // match, so label[for=input.id] misses. Fall back to the
                    // enclosing `.form-field` row, which always has exactly
                    // one label regardless of id/for matching.
                    const fieldRow = input.closest('.form-field');
                    const label = form.querySelector('label[for="' + input.id + '"]')
                        || (fieldRow ? fieldRow.querySelector('label') : null);
                    if (label && !label.querySelector('.domainmanager-lock')) {
                        const icon = document.createElement('i');
                        icon.className = 'ti ti-cloud-lock ms-1 domainmanager-lock';
                        icon.title = {{ __('Locked by Domain Manager synchronization', 'domainmanager')|json_encode|raw }};
                        label.appendChild(icon);
                    }
                });
            });
        }
    }

    // §9 Phase 14: unlink the registrar (clears Infocom's Supplier field),
    // bypassing the suppliers_id lock without requiring the unlock right —
    // same fetch/CSRF convention as Update Now and the reassign button.
    const unlinkButton = document.getElementById('domainmanager-unlink-registrar');
    if (unlinkButton) {
        unlinkButton.addEventListener('click', function () {
            if (!window.confirm({{ __('Unlink this domain\'s registrar?', 'domainmanager')|json_encode|raw }})) {
                return;
            }
            const csrf = document.querySelector('meta[property="glpi:csrf_token"]');
            unlinkButton.disabled = true;

            fetch({{ path('/plugins/domainmanager/domainunlink/' ~ domains_id)|json_encode|raw }}, {
                method: 'POST',
                headers: {
                    'X-Glpi-Csrf-Token': csrf ? csrf.getAttribute('content') : '',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            }).then(function (response) {
                return response.json().then(function (data) {
                    return { ok: response.ok, data: data };
                });
            }).then(function (result) {
                if (!result.ok || !result.data.ok) {
                    throw new Error((result.data && result.data.message) || 'HTTP error');
                }
                window.location.reload();
            }).catch(function (error) {
                window.alert({{ __('Failed to unlink the registrar:', 'domainmanager')|json_encode|raw }} + ' ' + error.message);
                unlinkButton.disabled = false;
            });
        });
    }

    const labels  = {{ status_labels|json_encode|raw }};
    const classes = {{ status_classes|json_encode|raw }};

    function setBadge(id, status, message) {
        const badge = document.getElementById(id);
        if (!badge) {
            return;
        }
        badge.className = 'badge ' + (classes[status] || 'text-bg-secondary');
        badge.textContent = labels[status] || status;
        badge.title = message || '';
        // Bootstrap's Tooltip reads `data-bs-original-title`, not the plain
        // `title` attribute, once it's already initialized (common.js's
        // initTooltips() only wires up `[data-bs-toggle="tooltip"]` nodes
        // once, on page load / jQuery ajaxComplete) — updating `title` alone
        // would silently leave the tooltip showing this badge's very first
        // message forever after a live sync.
        if (badge.hasAttribute('data-bs-original-title')) {
            badge.setAttribute('data-bs-original-title', message || '');
        }
    }

    // Phase 92: both icons below disable permanently on first click (dimmed,
    // pointer-events off) rather than re-enabling once the request settles
    // — a full page reload is the only way to sync/RDAP-check again. This
    // is a deliberate one-click-per-page-load guard against hammering
    // either endpoint (registrar/DNS driver APIs, or rdap.org's own rate
    // limit), not a cooldown timer.
    function lockIcon(icon) {
        icon.style.pointerEvents = 'none';
    }

    function disablePermanently(icon) {
        icon.classList.add('disabled');
        icon.style.pointerEvents = 'none';
        icon.style.opacity = '0.5';
    }

    const regDnsIcon = document.getElementById('domainmanager-sync-regdns');
    if (regDnsIcon) {
        function runSync(force) {
            const csrf = document.querySelector('meta[property="glpi:csrf_token"]');
            regDnsIcon.classList.add('icon-rotate', 'd-inline-block');

            return fetch({{ path('/plugins/domainmanager/sync/' ~ domains_id)|json_encode|raw }}, {
                method: 'POST',
                headers: {
                    'X-Glpi-Csrf-Token': csrf ? csrf.getAttribute('content') : '',
                    'X-Requested-With': 'XMLHttpRequest',
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: force ? 'force=1' : ''
            }).then(function (response) {
                return response.json().then(function (data) {
                    return { ok: response.ok, data: data };
                });
            }).then(function (result) {
                if (!result.ok) {
                    throw new Error(result.data.error || 'HTTP error');
                }
                const data = result.data;
                setBadge('domainmanager-badge-registrar', data.registrar_status, data.registrar_message);
                setBadge('domainmanager-badge-dns', data.dns_status, data.dns_message);

                const last = document.getElementById('domainmanager-lastsync');
                if (last) {
                    last.childNodes[0].textContent = data.last_sync_date + ' ';
                }

                const provider = document.getElementById('domainmanager-provider');
                if (provider && data.detected_provider) {
                    if (data.dns_supplier_link_url) {
                        provider.textContent = '';
                        const link = document.createElement('a');
                        link.href = data.dns_supplier_link_url + '{{ supplier_tab_forcetab }}';
                        link.textContent = data.detected_provider;
                        provider.appendChild(link);
                    } else {
                        provider.textContent = data.detected_provider;
                    }
                }

                const warning = document.getElementById('domainmanager-provider-warning');
                if (warning) {
                    const text = document.getElementById('domainmanager-provider-warning-text');
                    if (data.dns_status === 'unsupported' || data.dns_status === 'unknown') {
                        warning.classList.remove('d-none');
                        if (text) {
                            text.textContent = data.dns_message;
                        }
                    } else {
                        warning.classList.add('d-none');
                    }
                }

                // ARCHITECTURE.md §15.3 Phase 55: this run's reconciliation
                // refused to apply because it would have trashed more records
                // than the configured sync safety guard allows — the domain
                // was left untouched. Offer an explicit, one-off override
                // rather than silently retrying or leaving no way forward
                // short of the Setup config page.
                if (data.dns_status === 'sync_safety_guard' && !force) {
                    if (window.confirm(data.dns_message + '\n\n' + {{ __('Force this synchronization anyway?', 'domainmanager')|json_encode|raw }})) {
                        return runSync(true);
                    }
                }
            }).catch(function (error) {
                window.alert({{ __('Synchronization request failed:', 'domainmanager')|json_encode|raw }} + ' ' + error.message);
            }).finally(function () {
                regDnsIcon.classList.remove('icon-rotate', 'd-inline-block');
                disablePermanently(regDnsIcon);
            });
        }

        regDnsIcon.addEventListener('click', function () {
            lockIcon(regDnsIcon);
            runSync(false);
        }, { once: true });
    }

    const rdapIcon = document.getElementById('domainmanager-sync-rdap');
    if (rdapIcon) {
        rdapIcon.addEventListener('click', function () {
            const csrf = document.querySelector('meta[property="glpi:csrf_token"]');
            lockIcon(rdapIcon);
            rdapIcon.classList.add('icon-rotate', 'd-inline-block');

            fetch({{ path('/plugins/domainmanager/rdapsync/' ~ domains_id)|json_encode|raw }}, {
                method: 'POST',
                headers: {
                    'X-Glpi-Csrf-Token': csrf ? csrf.getAttribute('content') : '',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            }).then(function (response) {
                return response.json().then(function (data) {
                    return { ok: response.ok, data: data };
                });
            }).then(function (result) {
                if (!result.ok) {
                    throw new Error(result.data.error || 'HTTP error');
                }
                const data = result.data;
                const rdap = document.getElementById('domainmanager-lastrdap');
                if (rdap && data.last_rdap_check_date) {
                    rdap.childNodes[0].textContent = data.last_rdap_check_date + ' ';
                }
            }).catch(function (error) {
                window.alert({{ __('RDAP lookup request failed:', 'domainmanager')|json_encode|raw }} + ' ' + error.message);
            }).finally(function () {
                rdapIcon.classList.remove('icon-rotate', 'd-inline-block');
                disablePermanently(rdapIcon);
            });
        }, { once: true });
    }
})();
</script>
