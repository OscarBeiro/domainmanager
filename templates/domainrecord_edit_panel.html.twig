{#
 # Rendered from `DomainForm::injectDomainRecord()` (§9 Phase 37) on a
 # plugin-imported `DomainRecord`'s own native edit page. Driver-agnostic —
 # `can_update`/`can_delete` only depend on `DnsRecordWriteback::isDomainDnsEditable()`
 # (any `DnsRecordWriterInterface` driver) plus this user's per-type rights,
 # never on which provider is actually configured.
 #}
{% if conflict_url %}
    <div class="alert alert-warning d-flex align-items-center mb-3" role="alert">
        <i class="ti ti-alert-triangle me-2"></i>
        <div>
            {{ __('This record has an unresolved update conflict with the provider.', 'domainmanager') }}
            <a href="{{ conflict_url }}">{{ __('Review it', 'domainmanager') }}</a>
        </div>
    </div>
{% endif %}
{% if can_update %}
    <div class="card m-n2 border-0 shadow-none mb-3">
        <div class="card-header">
            <div class="ribbon ribbon-bookmark ribbon-top ribbon-start bg-orange s-1">
                <i class="ti ti-world-cog fa-2x"></i>
            </div>
            <h4 class="card-title ps-5">{{ __('Managed by Domain Manager', 'domainmanager') }}</h4>
        </div>
        <div class="card-body">
            <div class="text-muted small">
                {% if supplier_name %}
                    {{ __('Saving this form updates the record live at %s. There is no undo.', 'domainmanager')|replace({'%s': supplier_name}) }}
                {% else %}
                    {{ __('Saving this form updates the record live at the DNS provider. There is no undo.', 'domainmanager') }}
                {% endif %}
            </div>
        </div>
    </div>
{% elseif locked_fields is not empty %}
    <div class="alert alert-secondary d-flex align-items-center mb-3" role="alert">
        <i class="ti ti-lock me-2"></i>
        <div>{{ __('This record is imported by Domain Manager synchronization and cannot be edited here.', 'domainmanager') }}</div>
    </div>
{% endif %}
<script>
    (function () {
        var lockedFields = {{ locked_fields|json_encode|raw }}.concat({{ structural_locked_fields|json_encode|raw }});
        if (lockedFields.length) {
            var form = document.getElementById('main-form') || document.querySelector('form[name="asset_form"]');
            if (form) {
                lockedFields.forEach(function (field) {
                    form.querySelectorAll('[name="' + field + '"]').forEach(function (input) {
                        input.disabled = true;
                        var label = form.querySelector('label[for="' + input.id + '"]');
                        if (label && !label.querySelector('.domainmanager-lock')) {
                            var icon = document.createElement('i');
                            icon.className = 'ti ti-lock ms-1 domainmanager-lock';
                            icon.title = {{ __('Locked by Domain Manager synchronization', 'domainmanager')|json_encode|raw }};
                            label.appendChild(icon);
                        }
                    });
                });
            }
        }

        {% if can_delete %}
        var deleteButtons = document.querySelectorAll(
            '.form-button-separator button[name="delete"], .form-button-separator button[name="purge"]'
        );
        deleteButtons.forEach(function (btn) {
            btn.addEventListener('click', function (event) {
                if (!window.confirm({{ __('This deletes the record live at the DNS provider. Continue?', 'domainmanager')|json_encode|raw }})) {
                    event.preventDefault();
                    event.stopImmediatePropagation();
                }
            }, true);
        });
        {% endif %}
    })();
</script>
