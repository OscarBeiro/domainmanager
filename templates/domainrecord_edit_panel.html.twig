{#
 # Rendered from `DomainForm::injectDomainRecord()` (§9 Phase 37) on a
 # plugin-imported `DomainRecord`'s own native edit page. Driver-agnostic —
 # `can_update`/`can_delete` only depend on `DnsRecordWriteback::isDomainDnsEditable()`
 # (any `DnsRecordWriterInterface` driver) plus this user's per-type rights,
 # never on which provider is actually configured.
 #}
{% if can_update %}
    <div class="card m-n2 border-0 shadow-none mb-3" id="domainmanager-managed-banner" style="display:none">
        <div class="card-header">
            <div class="ribbon ribbon-bookmark ribbon-top ribbon-start bg-blue s-1">
                <i class="ti ti-world-cog fa-2x"></i>
            </div>
            <h4 class="card-title ps-5">{{ __('Managed by Domain Manager', 'domainmanager') }}</h4>
        </div>
        <div class="card-body">
            <div class="text-muted small">
                {% if supplier_name %}
                    {{ __('Saving this form updates the record live at %s. There is no undo.', 'domainmanager')|replace({'%s': supplier_name}) }}
                {% else %}
                    {{ __('Saving this form updates the record live at the DNS provider. There is no undo.', 'domainmanager') }}
                {% endif %}
            </div>
            {% if ttl_auto_note %}
                <div class="text-muted small mt-1">
                    <i class="ti ti-info-circle"></i>
                    {{ __('Setting TTL to 1 means "Automatic".', 'domainmanager') }}
                </div>
            {% endif %}
        </div>
    </div>
{% endif %}
{% if can_toggle_proxy %}
    <div class="form-check form-switch mb-3" id="domainmanager-proxy-toggle-container" style="display:none">
        {# Unchecked checkboxes submit nothing at all — this hidden "0"
         # fallback is what actually lets a user turn proxying *off*; the
         # checkbox below shares its name and, when checked, its "1" simply
         # arrives after the hidden field's "0" in $_POST/$item->input,
         # which — like any repeated form field — keeps only the last value. #}
        <input type="hidden" name="_domainmanager_proxied" value="0">
        <input
            class="form-check-input"
            type="checkbox"
            role="switch"
            id="domainmanager-proxy-toggle"
            name="_domainmanager_proxied"
            value="1"
            {{ current_proxied ? 'checked' : '' }}
        >
        <label class="form-check-label" for="domainmanager-proxy-toggle">
            <i class="ti ti-cloud-filled"></i>
            {{ __('Proxied', 'domainmanager') }}
        </label>
    </div>
{% endif %}
{% if read_only_locked %}
    <div class="alert alert-warning mb-3" role="alert">
        <i class="ti ti-lock me-1"></i>
        {{ __('Domain Manager is in read-only mode (Setup > General > Domain Manager); this record cannot be edited here until it is turned off.', 'domainmanager') }}
    </div>
{% elseif not can_update and locked_fields is not empty %}
    <div class="alert alert-secondary mb-3" role="alert">
        <i class="ti ti-cloud-lock me-1"></i>
        {{ __('This record is imported by Domain Manager synchronization and cannot be edited here.', 'domainmanager') }}
    </div>
{% endif %}
<script>
    (function () {
    // GLPI renders `.form-button-separator` (and its Save/Delete/Purge
    // buttons) via `components/form/buttons.html.twig` *after* this
    // POST_ITEM_FORM hook output in the document — so at parse time, when
    // this inline <script> runs synchronously, that row doesn't exist in
    // the DOM yet. Deferring to DOMContentLoaded lets the rest of the page
    // finish parsing first.
    function run() {
        var form = document.getElementById('main-form') || document.querySelector('form[name="asset_form"]');
        var lockedFields = {{ locked_fields|json_encode|raw }}.concat({{ structural_locked_fields|json_encode|raw }});
        {% if display_name is not null %}
        // Stored `name` is always the absolute FQDN (matches every driver's
        // own ZoneRecord.name); show just the relative label against the
        // already-linked domain, same as core's own DomainRecord::
        // getDisplayName() already does for the "link a record" dropdown.
        // Cosmetic only — this field is locked either way (see
        // structural_locked_fields below), so this can never post a
        // different value back.
        if (form) {
            form.querySelectorAll('[name="name"]').forEach(function (input) {
                input.value = {{ display_name|json_encode|raw }};
            });
        }
        {% endif %}

        if (lockedFields.length) {
            if (form) {
                lockedFields.forEach(function (field) {
                    form.querySelectorAll('[name="' + field + '"]').forEach(function (input) {
                        input.disabled = true;
                        // date_creation is built by dateField()/datetimeField()
                        // (fields_macros.html.twig), whose flatpickr wrapper
                        // gets its own random id independently of the outer
                        // field() macro's label `for` — the two never match.
                        // Fall back to the enclosing `.form-field` row, which
                        // always has exactly one label regardless of it.
                        var label = form.querySelector('label[for="' + input.id + '"]')
                            || (input.closest('.form-field') ? input.closest('.form-field').querySelector('label') : null);
                        if (label && !label.querySelector('.domainmanager-lock')) {
                            var icon = document.createElement('i');
                            icon.className = 'ti ti-cloud-lock ms-1 domainmanager-lock';
                            icon.title = {{ __('Locked by Domain Manager synchronization', 'domainmanager')|json_encode|raw }};
                            label.appendChild(icon);
                        }
                    });
                });
            }
        }

        {% if can_update %}
        // The "Managed by Domain Manager" banner is rendered by GLPI's
        // POST_ITEM_FORM hook at the very end of the form body (right
        // before the submit buttons) — there is no server-side way to
        // place plugin-injected content earlier in a native form, so it's
        // moved to the top here, before the first native field, and only
        // then revealed (never left in its original spot even briefly).
        var banner = document.getElementById('domainmanager-managed-banner');
        if (banner && form) {
            var firstField = form.querySelector('.card-body, .row, .form-field') || form.firstElementChild;
            if (firstField && firstField.parentNode && firstField !== banner) {
                firstField.parentNode.insertBefore(banner, firstField);
            } else {
                form.insertBefore(banner, form.firstChild);
            }
            banner.style.display = '';
        }
        {% endif %}

        {% if can_toggle_proxy %}
        // `is_proxied` lives on ImportedRecord, not DomainRecord (§9 Phase
        // 49) — there is no real form field for it to occupy, so the
        // checkbox rendered above (hidden, outside the <form>) is moved
        // into the native form here. Earlier attempts anchored it to
        // `date_creation`/`ttl` rows, which are unreliable across GLPI
        // versions/layouts; anchoring to `.form-button-separator` (the
        // submit/delete button row, always present) is stable, so it's
        // placed directly above that row instead — and only then revealed,
        // never left detached-but-visible even briefly.
        var proxyContainer = document.getElementById('domainmanager-proxy-toggle-container');
        if (proxyContainer && form) {
            var buttonSeparator = form.querySelector('.form-button-separator');
            if (buttonSeparator && buttonSeparator.parentNode) {
                buttonSeparator.parentNode.insertBefore(proxyContainer, buttonSeparator);
            } else {
                form.appendChild(proxyContainer);
            }
            proxyContainer.style.display = '';
        }
        {% endif %}

        {% if can_delete %}
        var deleteButtons = document.querySelectorAll(
            '.form-button-separator button[name="delete"], .form-button-separator button[name="purge"]'
        );
        deleteButtons.forEach(function (btn) {
            btn.addEventListener('click', function (event) {
                if (!window.confirm({{ __('This deletes the record live at the DNS provider. Continue?', 'domainmanager')|json_encode|raw }})) {
                    event.preventDefault();
                    event.stopImmediatePropagation();
                }
            }, true);
        });
        {% endif %}

        {% if not can_purge %}
        // GLPI renders the Purge button from the generic itemtype right,
        // unaware of Domain Manager's own per-type PURGE bit — without this
        // it's shown but silently rejected server-side by
        // LockEnforcer::blockRecordRemoval() (kept there, authoritative, in
        // case some other path — e.g. an automatic action — still reaches it).
        var purgeButtons = document.querySelectorAll('.form-button-separator button[name="purge"]');
        purgeButtons.forEach(function (btn) {
            btn.style.display = 'none';
        });
        {% endif %}
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', run);
    } else {
        run();
    }
    })();
</script>
