{#
 # Rendered from `DomainForm::inject()` (main tab) and `DomainForm::onShowTab()`
 # (every other tab, e.g. Records) — see §9 Phase 36. `.navigationheader-title`
 # is core's own item-title element (`src/CommonGLPI.php::showNavigationHeader()`),
 # rendered once per page load regardless of which tab is active/forced, so a
 # single idempotent insert here covers every tab without re-injecting on
 # client-side ajax tab switches (the header itself is never swapped).
 #}
{% if is_managed %}
    <script>
        (function () {
            var title = document.querySelector('.navigationheader-title');
            if (title && !title.querySelector('.domainmanager-managed-icon')) {
                var icon = document.createElement('i');
                icon.className = 'ti ti-world-cog ms-2 domainmanager-managed-icon';
                icon.title = {{ __('Managed by Domain Manager', 'domainmanager')|json_encode|raw }};
                title.appendChild(icon);
            }
        })();
    </script>
{% endif %}
{% if hide_native_buttons %}
    {#
     # Hides core's own "Link a record" + "New Domain record for this item"
     # controls (`DomainRecord::showForDomain()`) as a unit: both live as
     # siblings inside the same wrapping `<div class="mb-3">`, whose only
     # other stable (non-random, non-translated) hook is the "Link a record"
     # form's `id="domain_form{{ rand }}"` — so hiding that form's closest
     # `div.mb-3` ancestor takes the whole block with it, without matching on
     # translated button text or a `mt-rand()` suffix.
     #}
    <script>
        (function () {
            document.querySelectorAll('form[id^="domain_form"]').forEach(function (form) {
                var wrapper = form.closest('div.mb-3');
                if (wrapper) {
                    wrapper.style.display = 'none';
                }
            });
        })();
    </script>
{% endif %}
