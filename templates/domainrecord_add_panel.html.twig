{#
 # Rendered from `DomainForm::renderRecordWritePanel()` (§9 Phase 37) on the
 # Records tab of any domain whose DNS is genuinely under write-back — driver
 # agnostic, never gated on IONOS specifically (`DnsRecordWriteback::isDomainDnsEditable()`
 # only checks for `DnsRecordWriterInterface`). Always hides core's native
 # "Link a record"/"New Domain record for this item" controls
 # (`DomainRecord::showForDomain()`) on such a domain and replaces them with
 # this Domain-Manager-branded form — scoped to only the types `type_options`
 # actually lists (this user's per-type CREATE rights), so every click here
 # is guaranteed to either succeed live or be denied loudly, never silently
 # local-only.
 #}
{% import 'components/form/basic_inputs_macros.html.twig' as inputs %}
<div id="domainmanager-add-record-panel" class="d-none">
    <div class="card m-n2 border-0 shadow-none">
        <div class="card-header">
            <div class="ribbon ribbon-bookmark ribbon-top ribbon-start bg-blue s-1">
                <i class="ti ti-world-cog fa-2x"></i>
            </div>
            <h4 class="card-title ps-5">{{ __('Add a DNS record (Domain Manager)', 'domainmanager') }}</h4>
        </div>
        <div class="card-body">
            {% if read_only %}
                <div class="text-muted small">
                    {{ __('Domain Manager is in read-only mode (Setup > General > Domain Manager); no new record can be created here until it is turned off.', 'domainmanager') }}
                </div>
            {% elseif type_options is empty %}
                <div class="text-muted small">
                    {{ __('You do not hold write-back rights for any record type on this domain — ask an administrator for the "Domain Manager" per-type rights on your profile.', 'domainmanager') }}
                </div>
            {% else %}
                <div class="text-muted small mb-2">
                    {{ live_notice }}
                </div>
                <form method="post" action="{{ add_form_url }}" data-submit-once id="domainmanager-add-record-form">
                    {{ inputs.hidden('_glpi_csrf_token', csrf_token()) }}
                    {{ inputs.hidden('domains_id', domains_id) }}
                    {#
                     # `front/domainrecord.form.php`'s own add-handling redirects to the
                     # new record's own native edit page whenever the submitting user's
                     # `glpibackcreated` preference is on (`Html::redirect($record->getFormURLWithID($newID))`),
                     # and only falls back to `Html::back()` (return to the referring
                     # page — this Records tab) when `_in_modal` is set on the request,
                     # regardless of that per-user preference. This isn't really a modal,
                     # but it's the one native switch that keeps the user on this tab
                     # after a create instead of bouncing them to the generic native form.
                     #}
                    {{ inputs.hidden('_in_modal', 1) }}
                    <div class="d-flex flex-wrap gap-2 align-items-end">
                        <div style="width: 8rem;">
                            <label class="form-label">{{ _n('Type', 'Types', 1) }}</label>
                            <select name="domainrecordtypes_id" class="form-select" required>
                                {% for id, name in type_options %}
                                    <option value="{{ id }}">{{ name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div style="width: 10rem;">
                            <label class="form-label">{{ __('Name') }}</label>
                            <input type="text" name="name" class="form-control" placeholder="@">
                        </div>
                        <div class="flex-grow-1" style="min-width: 10rem;">
                            <label class="form-label">{{ _n('Target', 'Targets', 1) }}</label>
                            <input type="text" name="data" class="form-control" required>
                        </div>
                        <div style="width: 6rem;">
                            <label class="form-label">
                                TTL
                                {% if ttl_auto_note %}
                                    <i class="ti ti-info-circle" title="{{ __('Setting TTL to 1 means "Automatic".', 'domainmanager') }}"></i>
                                {% endif %}
                            </label>
                            <input type="number" name="ttl" class="form-control" value="3600" min="60" max="99999" maxlength="5">
                        </div>
                        <div>
                            <button type="submit" name="add" class="btn btn-primary text-nowrap">
                                <i class="ti ti-plus"></i>
                                {{ __('New record', 'domainmanager') }}
                            </button>
                        </div>
                    </div>
                </form>
            {% endif %}
        </div>
    </div>
</div>
{#
 # Hides the native block (same selector strategy as Phase 36: the one
 # stable, non-translated, non-`mt_rand()` hook is the "Link a record"
 # form's `id="domain_form{{ rand }}"` prefix, walking up to its closest
 # `div.mb-3` — that wrapper holds both the "Link a record" form and the
 # "New Domain record" button as siblings) and relocates this panel into its
 # place, mirroring the existing "Update Now" button relocation convention
 # already used in `domain_panel.html.twig`.
 #}
<script>
    (function () {
        var panel = document.getElementById('domainmanager-add-record-panel');
        document.querySelectorAll('form[id^="domain_form"]').forEach(function (form) {
            var wrapper = form.closest('div.mb-3');
            if (wrapper && panel) {
                wrapper.insertAdjacentElement('afterend', panel);
                panel.classList.remove('d-none');
                wrapper.style.display = 'none';
            }
        });

        var addForm = document.getElementById('domainmanager-add-record-form');
        if (addForm) {
            addForm.addEventListener('submit', function (event) {
                if (!window.confirm({{ __('This creates the record live at the DNS provider. Continue?', 'domainmanager')|json_encode|raw }})) {
                    event.preventDefault();
                    event.stopImmediatePropagation();
                }
            }, true);
        }
    })();
</script>
