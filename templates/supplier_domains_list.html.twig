<div class="card m-2 border-0 shadow-none" id="domainmanager-domains-list">
    <div class="card-header">
        <div class="ribbon ribbon-bookmark ribbon-top ribbon-start bg-blue s-1">
            <i class="ti ti-world fa-2x"></i>
        </div>
        <h4 class="card-title ps-5">
            {{ __('Domains', 'domainmanager') }}
        </h4>
    </div>
    {% if never_synced_count > 0 %}
        <div class="alert alert-info d-flex align-items-center justify-content-between m-2 mb-0" role="alert">
            <div>
                <i class="ti ti-info-circle me-1"></i>
                {{ _n('%d domain linked to this supplier hasn\'t been checked yet — run a sync to detect its DNS provider and status.', '%d domains linked to this supplier haven\'t been checked yet — run a sync to detect their DNS provider and status.', never_synced_count, 'domainmanager')|format(never_synced_count) }}
            </div>
            <a href="{{ domains_search_url }}" class="btn btn-sm btn-outline-info ms-3 text-nowrap">
                {{ __('Review and sync', 'domainmanager') }}
            </a>
        </div>
    {% endif %}
    <div class="card-body p-0">
        {# Registrar/DNS status only ever hold one short badge word — left to
           the browser's own content-based sizing, they crowd out the
           Registrar/DNS Provider name columns, which can hold a much longer
           Supplier name. Table-layout: fixed + explicit widths give the
           status columns just enough room and split the rest evenly across
           the name-bearing columns instead. #}
        <style>
            #domainmanager-domains-list table {
                table-layout: fixed;
            }
            #domainmanager-domains-list thead th:nth-child(1) { width: 20%; }
            #domainmanager-domains-list thead th:nth-child(2) { width: 18%; }
            #domainmanager-domains-list thead th:nth-child(3) { width: 10%; }
            #domainmanager-domains-list thead th:nth-child(4) { width: 18%; }
            #domainmanager-domains-list thead th:nth-child(5) { width: 10%; }
            #domainmanager-domains-list thead th:nth-child(6) { width: 19%; }
            #domainmanager-domains-list thead th:nth-child(7) { width: 5%; }
        </style>
        {{ include('components/datatable.html.twig', datatable_params) }}
    </div>
</div>
