{# Edit modal for DNS records (ARCHITECTURE.md §11.10) — shows previous
   versus new, field by field. The "previous" side is a live re-fetch from
   the provider, with disagreement surfaced and graceful fallback if fetch fails. #}

<form method="post" action="{{ path('@domainmanager:domainmanager_dnsrecord_edit', { 'domains_id': domain.fields.id, 'domainrecords_id': record.fields.id }) }}" id="domainmanager-dnsrecord-edit-form">
    <div class="modal-body">
        {% if live_fetch_failed %}
            <div class="alert alert-warning mb-3">
                <i class="ti ti-alert-triangle me-1"></i>
                {{ __('Could not verify current values against the provider; values shown are from the last sync', 'domainmanager') }}
            </div>
        {% endif %}

        {% if live_fetch and live_fetch.data != record.fields.data %}
            <div class="alert alert-info mb-3">
                <i class="ti ti-info-circle me-1"></i>
                {{ __('Warning: Record value has changed in the provider since last sync', 'domainmanager') }}
            </div>
        {% endif %}

        <div class="mb-3">
            <label class="form-label">{{ __('Domain', 'domainmanager') }}</label>
            <div class="form-control-plaintext">{{ domain.fields.name }}</div>
        </div>

        <div class="mb-3">
            <label class="form-label">{{ __('Record Type', 'domainmanager') }}</label>
            <div class="form-control-plaintext">{{ type }}</div>
        </div>

        <div class="mb-3">
            <label class="form-label">{{ __('Name', 'domainmanager') }}</label>
            <div class="row">
                <div class="col-6">
                    <small class="text-muted d-block mb-1">{{ __('Current', 'domainmanager') }}</small>
                    <div class="form-control-plaintext">{{ live_fetch ? live_fetch.name : record.fields.name }}</div>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block mb-1">{{ __('New', 'domainmanager') }}</small>
                    <input type="text" class="form-control" name="name" value="{{ record.fields.name }}" readonly>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">{{ __('Data', 'domainmanager') }}</label>
            <div class="row">
                <div class="col-6">
                    <small class="text-muted d-block mb-1">{{ __('Current', 'domainmanager') }}</small>
                    <div class="form-control-plaintext" style="word-break: break-all;">{{ live_fetch ? live_fetch.data : record.fields.data }}</div>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block mb-1">{{ __('New', 'domainmanager') }}</small>
                    <input type="text" class="form-control" name="data" value="{{ data }}" required>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">{{ __('TTL (seconds)', 'domainmanager') }}</label>
            <div class="row">
                <div class="col-6">
                    <small class="text-muted d-block mb-1">{{ __('Current', 'domainmanager') }}</small>
                    <div class="form-control-plaintext">{{ live_fetch ? live_fetch.ttl : record.fields.ttl }}</div>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block mb-1">{{ __('New', 'domainmanager') }}</small>
                    <input type="number" class="form-control" name="ttl" value="{{ ttl }}" min="60" required>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <input type="hidden" name="type" value="{{ type }}" />
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ _x('button', 'Cancel') }}</button>
        <button type="submit" class="btn btn-primary">
            <i class="ti ti-pencil"></i>
            {{ __('Update record', 'domainmanager') }}
        </button>
    </div>
</form>
