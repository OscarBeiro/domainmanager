# docs/manual/manual.env.example — copy to manual.env and fill in. manual.env is gitignored.
#
# The only file in the manual pipeline that knows about your machine. Every script sources
# this, so wiring the pipeline into a different plugin or a CI runner is one file to change.
#
# Fill in the five values marked CONFIRM by inspecting the running stack:
#   podman ps --format '{{.Names}}\t{{.Ports}}'
#   podman inspect <glpi-container> --format '{{json .NetworkSettings.Networks}}'

ENGINE=podman

# --- containers -------------------------------------------------------------------------
GLPI_CONTAINER=glpi                       # CONFIRM
DB_CONTAINER=glpi-db                      # CONFIRM

# --- how the Playwright container reaches GLPI ------------------------------------------
# Shared podman network + service name. Not localhost: inside the runner that is the runner.
GLPI_NETWORK=CHANGEME_default             # CONFIRM
BASE_URL=http://glpi                      # CONFIRM (add :port if GLPI isn't on 80 internally)
GLPI_HOST_PORT=CHANGEME                   # CONFIRM — host-published port, for restore.sh's warm-up request

# --- database ---------------------------------------------------------------------------
DB_NAME=glpi
DB_USER=glpi
DB_PASS=glpi
DB_ROOT_PASS=root                         # CONFIRM — restore drops/recreates the schema

# --- documentation identity -------------------------------------------------------------
PLUGIN_KEY=CHANGEME                       # the plugin directory name
GLPI_VERSION=11.0                         # stamped into the manual banner
TZ=Europe/Madrid
MANUAL_LOCALES="en_GB es_ES"              # add fr_FR when the translation exists

# Fixture password for the manual_* documentation users. Not a secret: these accounts exist
# only inside the throwaway docs database and never in a real deployment.
DOC_USER_PASS=manual-only-fixture-pw
